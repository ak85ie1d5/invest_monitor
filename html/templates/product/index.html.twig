{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}


<div class="example-wrapper">
    {% block aside %}
        {% include 'sidebar.html.twig' %}
    {% endblock %}
    <h1>{{ title }}</h1>

    <table>
        <thead>
            <tr>
                <th>Name</th>
                <th>Type</th>
                <th>Direction</th>
                <th>ISIN</th>
                <th>Stop loss level</th>
                <th>End date</th>
                <th>Leverage</th>
                <th>Underlying name</th>
                <th>Underlying ISIN</th>
            </tr>
        </thead>
        <tbody>
            {% for product in products %}
                <tr>
                    <td>{{ product.name }}</td>
                    <td>{{ product.productType }}</td>
                    <td>{{ product.productDirection }}</td>
                    <td>{{ product.Isin }}</td>
                    <td>{{ product.StopLossLevel }} {{ stopLossCurrency }}</td>
                    <td>{{ product.endDate }}</td>
                    <td>{{ product.leverage }}</td>
                    <td>{{ product.underlyingName }}</td>
                    <td>{{ product.underlyingIsin }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
