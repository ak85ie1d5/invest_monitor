{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block aside %}
    {% include 'sidebar.html.twig' %}
{% endblock %}

{% block header %}
    <h1 class="">{{ title }}</h1>
{% endblock %}

{% block body %}
    <twig:Table>
        <twig:Table:Head>
            <twig:Table:Row>
                <twig:Table:Header>Titre</twig:Table:Header>
                <twig:Table:Header>Date de publication</twig:Table:Header>
                <twig:Table:Header></twig:Table:Header>
            </twig:Table:Row>
        </twig:Table:Head>
        <twig:Table:Body>
            {% for article in articles %}
                <twig:Table:Row>
                    <twig:Table:Cell>{{ article.title }}</twig:Table:Cell>
                    <twig:Table:Cell>{{ article.publication_date|date("H:i m/d/Y") }}</twig:Table:Cell>
                    <twig:Table:Cell>
                        <a href="{{ article.link }}" target="_blank">View</a>
                    </twig:Table:Cell>
                </twig:Table:Row>
            {% endfor %}
        </twig:Table:Body>
    </twig:Table>
{% endblock %}
