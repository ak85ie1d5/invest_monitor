{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block aside %}
    {% include 'sidebar.html.twig' %}
{% endblock %}

{% block header %}
    <h1 class="">{{ title }}</h1>
{% endblock %}

{% block body %}
    <table>
        <thead>
            <tr>
                <th>Titre</th>
                <th>Date de publication</th>
                <th>Lien</th>
            </tr>
        </thead>
        <tbody>
            {% for article in articles %}
                <tr>
                    <td>{{ article.title }}</td>
                    <td>{{ article.publication_date|date("H:i m/d/Y") }}</td>
                    <td>
                        <a href="{{ article.link }}" target="_blank">Lien</a>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
