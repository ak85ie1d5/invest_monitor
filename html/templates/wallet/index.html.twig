{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block aside %}
    {% include 'sidebar.html.twig' %}
{% endblock %}

{% block header %}
    <h1 class="">{{ title }}</h1>
    <a href="{{ path('app_wallet_add_row') }}">Add new product</a>
{% endblock %}

{% block body %}
    {{ dump(walletRows)}}
    <table>
        <thead>
        <tr>
            <th>Name</th>
            <th>Type</th>
            <th>Direction</th>
            <th>Quantity purchased</th>
            <th>Purchase price</th>
            <th>Selling price</th>
            <th>Quantity sold</th>
            <th>Date of purchase</th>
            <th>Date of sale</th>
            <th>Article</th>
        </tr>
        </thead>
        <tbody>
        {% for walletRow in walletRows %}
            <tr>
                <td>{{ walletRow.Product.name }}</td>
                <td>{{ walletRow.Product.productType.value }}</td>
                <td>{{ walletRow.Product.productDirection.value }}</td>
                <td>{{ walletRow.quantityPurchased }}</td>
                <td>{{ walletRow.purchasePrice }}</td>
                <td>{{ walletRow.sellingPrice }}</td>
                <td>{{ walletRow.quantitySold }}</td>
                <td>{{ walletRow.dateOfPurchase|date }}</td>
                <td>{{ walletRow.dateOfSale|date }}</td>
                <td>
                    <a href="{{ walletRow.Article.link }}" title="{{ walletRow.Article.title }}" target="_blank">Lien</a>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}
